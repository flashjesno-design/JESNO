# ── AchatFlow : configuration (copiez ce fichier en « .env » ou saisissez ces valeurs dans l'hébergeur) ──

NODE_ENV=production
PORT=3000
APP_NAME=AchatFlow
# Adresse publique du site (sans « / » final). Utilisée dans les liens des e-mails et WhatsApp.
BASE_URL=https://fae.votre-domaine.com

# Secrets : générez chacun avec  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REMPLACEZ_PAR_UNE_LONGUE_VALEUR_ALEATOIRE
# Sert à signer les clés de licence que vous vendez. À conserver précieusement : la changer invalide toutes les clés émises.
LICENSE_SECRET=REMPLACEZ_PAR_UNE_AUTRE_VALEUR_ALEATOIRE

# Compte éditeur (vous) : crée les clients et leurs licences depuis « Clients & licences ».
SUPERADMIN_EMAIL=vous@votre-domaine.com
SUPERADMIN_PASSWORD=UnMotDePasseLongEtUnique1

# Dossier des données (base SQLite et pièces jointes). Sur un hébergeur, ce dossier doit être un DISQUE PERSISTANT.
DATA_DIR=./data

# Derrière un proxy HTTPS (Render, Caddy, Nginx…) laissez 1.
TRUST_PROXY=1

# ── E-mail ── brevo | resend | smtp
# Sur l'offre GRATUITE de Render, les ports SMTP sont bloqués : utilisez Brevo ou Resend (envoi par HTTPS).
EMAIL_PROVIDER=brevo
# Brevo (gratuit jusqu'à 300 e-mails/jour) : Paramètres > SMTP & API > Clés API
BREVO_API_KEY=
# ou Resend : RESEND_API_KEY=
# Adresse d'expédition, validée chez le fournisseur d'envoi
EMAIL_FROM="AchatFlow <alertes@votre-domaine.com>"
# SMTP classique (offres payantes uniquement sur Render) : EMAIL_PROVIDER=smtp puis SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS

# ── WhatsApp ── none | meta | twilio
WHATSAPP_PROVIDER=none
DEFAULT_COUNTRY_CODE=225
# Meta Cloud API (modèle de message « utility » approuvé à 4 variables : nom, n° FAE, message, lien)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=fae_notification
WHATSAPP_TEMPLATE_LANG=fr
# … ou Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID=

# Charge un client de démonstration au premier démarrage (à laisser sur false en production)
SEED_DEMO=false
